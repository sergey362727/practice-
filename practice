import math


def circle_area(r):
    return math.pi * r ** 2


def triangle_area(a, h):
    return a * h / 2


def sphere_volume(r):
    return 4 * math.pi * r ** 3 / 3


def cube_volume(a):
    return a ** 3


def hemisphere_area(r):
    return 2 * circle_area(r)


__version__ = "0.2.0"

__all__ = [
    "circle_area",
    "triangle_area",
