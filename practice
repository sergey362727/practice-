# 8.1

import math
import random
import sched
import time


G0 = 9.80665


def delta_v(m0, m1, isp=300):
    if isp <= 0:
        raise ValueError("Удельный импульс должен быть положительным")

    if m0 < m1 or m1 <= 0:
        raise ValueError("m0 должно быть больше или равно m1")

    return isp * G0 * math.log(m0 / m1)


def flight_time(distance_km, accel):
    if distance_km <= 0 or accel <= 0:
        raise ValueError(
            "Расстояние и ускорение должны быть положительными"
        )

    distance_m = distance_km * 1000

    return (
        2 * math.sqrt(
            (distance_m / 2) / accel
        ) / 3600
    )


def fuel_needed(m_dry, target_dv, isp=300):
    if m_dry <= 0:
        raise ValueError(
            "Сухая масса должна быть положительной"
        )

    if target_dv < 0:
        raise ValueError(
            "Требуемая delta-v не может быть отрицательной"
        )

    return m_dry * (
        math.exp(
            target_dv / (isp * G0)
        ) - 1
    )


EVENTS = [
    (
        "Микрометеорит пробил обшивку",
        -15,
        0.4,
    ),
    (
        "Солнечная вспышка: радиация",
        -10,
        0.2,
    ),
    (
        "Удачная коррекция курса",
        5,
        0.2,
    ),
    (
        "Найдены запасы предыдущей миссии",
        20,
        0.1,
    ),
    (
        "Отказ системы охлаждения",
        -25,
        0.1,
    ),
]


def random_event(seed=None):
    rnd = random.Random(seed)

    weights = [
        event[2]
        for event in EVENTS
    ]

    name, delta, _ = rnd.choices(
        EVENTS,
        weights=weights,
        k=1
    )[0]

    return name, delta


def main():
    days = 6
    seed = 42
    speed = 0

    print("=== АРЕС-1 ===")

    print(
        f"Delta-v: "
        f"{delta_v(12000, 8000):.2f} м/с"
    )

    print(
        f"Время перелёта: "
        f"{flight_time(225_000_000, 0.001):.2f} ч"
    )

    print(
        f"Необходимое топливо: "
        f"{fuel_needed(8000, 3500):.2f} кг"
    )

    resource = 100
    stopped = False
    events = []

    scheduler = sched.scheduler(
        time.time,
        time.sleep
    )

    start_time = time.time()

    def report(day):
        nonlocal resource, stopped

        if stopped:
            return

        event_seed = seed + day

        description, change = random_event(
            event_seed
        )

        resource += change
        resource = max(0, resource)

        events.append(
            (
                day,
                description,
                change,
                resource,
            )
        )

        elapsed = time.time() - start_time

        print(
            f"[{elapsed:5.2f} c] "
            f"Сутки {day:02d}: "
            f"{description}; "
            f"{change:+d}; "
            f"ресурс = {resource}"
        )

        if resource == 0:
            stopped = True
            print("МИССИЯ ПРЕРВАНА: ресурс исчерпан")

    for day in range(1, days + 1):
        scheduler.enter(
            (day - 1) * speed,
            1,
            report,
            argument=(day,)
        )

    print("\nНачало симуляции...\n")

    scheduler.run()

    print("\nИтоги:")
    print(f"Количество событий: {len(events)}")
    print(f"Конечный ресурс: {resource}")

    if resource > 0:
        print("Миссия завершена успешно.")
    else:
        print("Миссия завершена досрочно.")


if __name__ == "__main__":
    main()
